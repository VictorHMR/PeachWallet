<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PeachWallet.View.LancamentoPage"
             xmlns:models="clr-namespace:PeachWallet.Models"
             xmlns:fa="clr-namespace:UraniumUI.Icons.FontAwesome;assembly=UraniumUI.Icons.FontAwesome"
             xmlns:components="clr-namespace:PeachWallet.View.Components"
             xmlns:vm="clr-namespace:PeachWallet.ViewModel"
             Title="Lançamentos"
             x:Name="Root"
             x:DataType="vm:LancamentoVM">
    
    <Grid RowDefinitions="*, 60">
        
        <VerticalStackLayout Padding="20" Spacing="20" Grid.Row="0">
            <components:MonthPickerField
                WidthRequest="190"
                DisplayMember="Display"
                DisplayText="Display"
                ItemsSource="{Binding MesesDisponiveis}"
                SelectedItem="{Binding MesSelecionado}"
                SelectionChangedCommand="{Binding MesSelecionadoCommand}" />


            <VerticalStackLayout Spacing="10">
                    <Label Text="Lista de gastos"
                           FontAttributes="Bold"
                           FontSize="20" />
                    <ScrollView HeightRequest="400">

                    <CollectionView x:Name="lsvLancamentos"
                      ItemsSource="{Binding Lancamentos}"
                      RemainingItemsThreshold="20"
                      SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:LancamentoDTO">
                                <Grid ColumnDefinitions="Auto,*,Auto, Auto" RowDefinitions="Auto,Auto" Padding="0,5" ColumnSpacing="10">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                             Command="{Binding BindingContext.AbrirPopupLancamentoCommand, Source={x:Reference Root}}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    
                                    <Border WidthRequest="45"
                                            HeightRequest="45"
                                            BackgroundColor="{Binding CorTexto}"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 23" 
                                            Padding="10"
                                            VerticalOptions="Center">
                                        <Image>
                                            <Image.Source>
                                                <FontImageSource FontFamily="FASolid" Glyph="{Binding IconeLancamento}" Color="{StaticResource White}" />
                                            </Image.Source>
                                        </Image>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Descricao}"
                                               FontSize="16"
                                               FontAttributes="Bold" 
                                               TextColor="{StaticResource White}"/>
                                        <Label Text="{Binding DtLancamento, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                               FontSize="14" />
                                    </VerticalStackLayout>

                                    <!-- Percentual -->
                                    <Label Grid.Column="2"
                                           Text="{Binding ValorFormatado, StringFormat='{0:C}'}"
                                           FontSize="14"
                                           FontAttributes="Bold" 
                                           TextColor="{Binding CorTexto}"
                                           VerticalOptions="Center"/>

                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </ScrollView>

                </VerticalStackLayout>
            </VerticalStackLayout>
        <ImageButton BackgroundColor="{StaticResource Primary}"
                     CornerRadius="12"
                     WidthRequest="60"
                     HeightRequest="60"
                     Padding="10"
                     Grid.Row="1"
                     HorizontalOptions="End"
                     VerticalOptions="End"
                     Margin="20, 30"
                     Command="{Binding CriarLancamentoCommand}">
            <ImageButton.Source>
                <FontImageSource FontFamily="FASolid" Glyph="{x:Static fa:Solid.Plus}" Color="{StaticResource OffBlack}" />
            </ImageButton.Source>

        </ImageButton>
    </Grid>
</ContentPage>