<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:PeachWallet.Models"
             xmlns:fa="clr-namespace:UraniumUI.Icons.FontAwesome;assembly=UraniumUI.Icons.FontAwesome"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             x:Class="PeachWallet.View.ConfigsPage"
             Title="Configurações">

    <ScrollView VerticalOptions="Start" Padding="15, 0">
        <VerticalStackLayout Spacing="3">
            <Label Text="Lançamentos" FontSize="22" Margin="0,10,0,10" TextColor="{StaticResource Gray100}" />
            <Label Text="Contas usadas para lançamentos de:" FontSize="18" Margin="0" TextColor="{StaticResource Gray100}"/>

            <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, *" Margin="0" ColumnSpacing="10">

                <Label Text="Movimentações" FontSize="14" Grid.Row="0" Grid.Column="0" TextColor="{StaticResource Gray100}"/>
                <material:PickerField Grid.Row="1" Grid.Column="0" 
                    ItemsSource="{Binding ContaBancariaVM.ContasBancarias}"
                    ItemDisplayBinding="{Binding Nome}"
                    SelectedItem="{Binding ContaMovimentacao, Mode=TwoWay}"
                    Icon="{FontImageSource FontFamily=FASolid, Glyph={x:Static fa:Solid.AngleDown}}"
                    AllowClear="False"/>

                <Label Text="Investimentos" FontSize="14" Grid.Row="0" Grid.Column="1" TextColor="{StaticResource Gray100}"/>
                <material:PickerField Grid.Row="1" Grid.Column="1"
                    ItemsSource="{Binding ContaBancariaVM.ContasBancarias}"
                    ItemDisplayBinding="{Binding Nome}"
                    SelectedItem="{Binding ContaInvestimento, Mode=TwoWay}"
                    Icon="{FontImageSource FontFamily=FASolid, Glyph={x:Static fa:Solid.AngleDown}}"
                    AllowClear="False"/>
            </Grid>

        </VerticalStackLayout>

    </ScrollView>
</ContentPage>