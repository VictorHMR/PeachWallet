<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PeachWallet.View.LancamentoRecorrentePage"
             xmlns:models="clr-namespace:PeachWallet.Models"
             xmlns:fa="clr-namespace:UraniumUI.Icons.FontAwesome;assembly=UraniumUI.Icons.FontAwesome"
             xmlns:components="clr-namespace:PeachWallet.View.Components"
             xmlns:vm="clr-namespace:PeachWallet.ViewModel"
             Title="Lançamentos Mensais"
             x:Name="Root"
             x:DataType="vm:LancamentoRecorrenteVM">

    <Grid RowDefinitions="Auto,*">

        <VerticalStackLayout Padding="20" Spacing="20" Grid.Row="0">
            <Grid ColumnDefinitions="*,*" RowDefinitions="*,*" RowSpacing="10" ColumnSpacing="10">
                <Border Grid.Row="0" Grid.Column="0" HeightRequest="75"
                        BackgroundColor="{StaticResource NegativeDark}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 13" 
                        Padding="7"
                        VerticalOptions="Center">
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,*" >
                        <Image WidthRequest="20" HeightRequest="20" Grid.Row="0" Grid.Column="0">
                            <Image.Source>
                                <FontImageSource FontFamily="FASolid" Glyph="{x:Static fa:Solid.MoneyBillTransfer}" Color="{StaticResource NegativeLight}" />
                            </Image.Source>
                        </Image>
                        <Label Text="Gastos" Grid.Row="0" Grid.Column="1" FontSize="16" FontAttributes="Bold" Margin="10,0" />
                        <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2">
                            <Label Text="{Binding GastosPeriodo, StringFormat='Déb:  {0:C}'}" FontSize="14" FontAttributes="Bold" Margin="10,0" />
                            <Label Text="{Binding GastosCreditoPeriodo, StringFormat='Créd: {0:C}'}"  FontSize="14" FontAttributes="Bold" Margin="10,0" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" HeightRequest="75"
                        BackgroundColor="{StaticResource InvestmentDark}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 13" 
                        Padding="7"
                        VerticalOptions="Center">
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,*" RowSpacing="10">
                        <Image WidthRequest="20" HeightRequest="20" Grid.Row="0" Grid.Column="0">
                            <Image.Source>
                                <FontImageSource FontFamily="FASolid" Glyph="{x:Static fa:Solid.MoneyBillTrendUp}" Color="{StaticResource InvestmentLight}" />
                            </Image.Source>
                        </Image>
                        <Label Text="Investido" Grid.Row="0" Grid.Column="1" FontSize="16" FontAttributes="Bold" Margin="10,0" />
                        <Label Text="{Binding InvestidoPeriodo, StringFormat='{0:C}'}" Grid.Row="1" Grid.ColumnSpan="2" FontSize="18" FontAttributes="Bold" Margin="10,0" FontAutoScalingEnabled="True"  LineBreakMode="NoWrap" />
                    </Grid>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" HeightRequest="75"
                        BackgroundColor="{StaticResource PositiveDark}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 13" 
                        Padding="7"
                        VerticalOptions="Center">
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,*" RowSpacing="10">
                        <Image WidthRequest="20" HeightRequest="20" Grid.Row="0" Grid.Column="0">
                            <Image.Source>
                                <FontImageSource FontFamily="FASolid" Glyph="{x:Static fa:Solid.MoneyBill}" Color="{StaticResource PositiveLight}" />
                            </Image.Source>
                        </Image>
                        <Label Text="Entradas" Grid.Row="0" Grid.Column="1" FontSize="16" FontAttributes="Bold" Margin="10,0" />
                        <Label Text="{Binding EntradasPeriodo, StringFormat='{0:C}'}" Grid.Row="1" Grid.ColumnSpan="2" FontSize="18" FontAttributes="Bold" Margin="10,0" FontAutoScalingEnabled="True"  LineBreakMode="NoWrap"/>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" HeightRequest="75"
                        BackgroundColor="{StaticResource AvaliableDark}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 13" 
                        Padding="7"
                        VerticalOptions="Center">
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,*" RowSpacing="0" >
                        <Image WidthRequest="20" HeightRequest="20" Grid.Row="0" Grid.Column="0">
                            <Image.Source>
                                <FontImageSource FontFamily="FASolid" Glyph="{x:Static fa:Solid.MoneyBill}" Color="{StaticResource AvaliableLight}" />
                            </Image.Source>
                        </Image>
                        <Label Text="Disponivel" Grid.Row="0" Grid.Column="1" FontSize="16" FontAttributes="Bold" Margin="10,0" />
                        <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2">
                            <Label Text="{Binding DisponivelPeriodo, StringFormat='{0:C}'}"  FontSize="18" FontAttributes="Bold" Margin="10,0" FontAutoScalingEnabled="True"  LineBreakMode="NoWrap"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </Grid>
        </VerticalStackLayout>

        <Grid RowDefinitions="Auto,*" Padding="20, 10" RowSpacing="10" Grid.Row="1">
            <Grid ColumnDefinitions="*,Auto" Grid.Row="0">
                <Label Text="Movimentações" Grid.Column="0"
                           VerticalOptions="Center"
                           FontAttributes="Bold"
                           FontSize="20" />
                <ImageButton BackgroundColor="Transparent" BorderColor="{StaticResource Primary}" BorderWidth="2"
                        CornerRadius="12"
                        WidthRequest="10"
                        HeightRequest="10"
                        Padding="10"
                        Grid.Column="1"
                        VerticalOptions="Center"
                        Command="{Binding CriarLancamentoRecorrenteCommand}">
                    <ImageButton.Source>
                        <FontImageSource FontFamily="FASolid" Glyph="{x:Static fa:Solid.Plus}" Color="{StaticResource Primary}" />
                    </ImageButton.Source>

                </ImageButton>
            </Grid>

            <CollectionView x:Name="lsvLancamentos" Grid.Row="1"
                      ItemsSource="{Binding Lancamentos}"
                      RemainingItemsThreshold="20"
                      VerticalScrollBarVisibility="Always" VerticalOptions="FillAndExpand"
                      SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:LancamentoRecorrenteDTO">
                        <Grid ColumnDefinitions="Auto,*,Auto, Auto" Padding="0,5" ColumnSpacing="10">
                            <Border WidthRequest="45"
                                            HeightRequest="45"
                                            BackgroundColor="{Binding CorTexto}"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 23" 
                                            Padding="10"
                                            VerticalOptions="Center">
                                <Image>
                                    <Image.Source>
                                        <FontImageSource FontFamily="FASolid" Glyph="{Binding IconeLancamento}" Color="{StaticResource White}" />
                                    </Image.Source>
                                </Image>
                            </Border>

                            <Grid Grid.Column="1" RowSpacing="2" VerticalOptions="Center" RowDefinitions="*,*">
                                <Label Text="{Binding Descricao}"
                                               FontSize="16"
                                               FontAttributes="Bold" 
                                               TextColor="{StaticResource White}" Grid.Row="0" />
                                <Label Text="{Binding DtLancamento, StringFormat='{0:dd/MM/yyyy HH:mm}'}" FontSize="14" Grid.Row="1" />
                            </Grid>

                            <Grid RowDefinitions="*,*" Grid.Column="2">
                                <Label Grid.Row="0"
                                               Text="{Binding ValorFormatado, StringFormat='{0:C}'}"
                                               FontSize="14"
                                               FontAttributes="Bold" 
                                               TextColor="{Binding CorTexto}"
                                               VerticalOptions="Center"/>
                                <Label Grid.Row="1"
                                            Text="{Binding CreditoDebito}"
                                            TextColor="{StaticResource Gray100}" 
                                            FontSize="12" 
                                            HorizontalOptions="End"/>
                            </Grid>

                            <Grid Grid.Column="3"
                                          VerticalOptions="Center"
                                          HorizontalOptions="Center"
                                          HeightRequest="25"
                                          WidthRequest="70"
                                          ColumnDefinitions="*, *"
                                          ColumnSpacing="0">
                                <ImageButton Grid.Column="0" Margin="0"
                                            BackgroundColor="Transparent"
                                            Command="{Binding BindingContext.AtualizarLancamentoRecorrenteCommand, Source={x:Reference Root}}"
                                            CommandParameter="{Binding .}">
                                    <ImageButton.Source>
                                        <FontImageSource FontFamily="FASolid" Glyph="{x:Static fa:Solid.Pen}" Color="{StaticResource White}" />
                                    </ImageButton.Source>
                                </ImageButton>
                                <ImageButton Grid.Column="1"
                                            Command="{Binding BindingContext.RemoverLancamentoRecorrenteCommand, Source={x:Reference Root}}"
                                            CommandParameter="{Binding .}">
                                    <ImageButton.Source>
                                        <FontImageSource FontFamily="FASolid" Glyph="{x:Static fa:Solid.TrashCan}" Color="{StaticResource White}" />
                                    </ImageButton.Source>
                                </ImageButton>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>


        </Grid>
    </Grid>
</ContentPage>