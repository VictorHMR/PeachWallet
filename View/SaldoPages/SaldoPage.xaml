<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:PeachWallet.Models"
             xmlns:fa="clr-namespace:UraniumUI.Icons.FontAwesome;assembly=UraniumUI.Icons.FontAwesome"
             x:Class="PeachWallet.View.SaldoPage"
             x:Name="SaldoPageRef"
             Title="Saldo">

    <ScrollView VerticalOptions="Start" Padding="15, 0">
        <VerticalStackLayout Spacing="3">

            <Border
                BackgroundColor="{StaticResource MidnightBlue}"
                Padding="20"
                Margin="0, 15"
                HeightRequest="110"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 9">
                <VerticalStackLayout Spacing="3">
                    <Label Text="Saldo Total" FontSize="20" HorizontalTextAlignment="Center"/>
                    <Label Text="{Binding SaldoTotal, StringFormat='R$ {0:N0}'}" FontSize="28" FontAttributes="Bold" x:Name="lblSaldoTotal" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Border>

            <Label Text="Por Conta"
                   FontSize="18"
                   Margin="0,0,0,5"
                   TextColor="#B0B0B0"
                   FontAttributes="Bold" />
            
            <Border
                BackgroundColor="#1E1F24"
                StrokeShape="RoundRectangle 9"
                StrokeThickness="0"
                BindingContext="{Binding ContaBancariaVM}">

                <VerticalStackLayout Spacing="0">


                    <!-- CABEÇALHO -->
                    <Grid ColumnDefinitions="4*,4*,2*" Padding="16, 8, 0, 0">
                        <Label Text="Conta" TextColor="{StaticResource Gray400}" FontSize="16" />
                        <Label Grid.Column="1" Text="Saldo" TextColor="{StaticResource Gray400}" FontSize="16"  />
                    </Grid>
                    
                    <BoxView StyleClass="Divider" Margin="0,10,0,0" />
                    
                    <!-- LISTA -->
                    <CollectionView ItemsSource="{Binding ContasBancarias}"
                        SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ContaBancariaDTO">
                                <VerticalStackLayout>
                                    
                                <Border StrokeThickness="0"
                                        BackgroundColor="Transparent"
                                        Padding="16, 0, 16, 0"
                                        Margin="0,10">

                                    <Grid ColumnDefinitions="4*,4*,2*" 
                                          VerticalOptions="Center">

                                        <!-- NOME DA CONTA -->
                                        <Label Grid.Column="0"
                                               Text="{Binding Nome}"
                                               TextColor="White"
                                               FontSize="16" />

                                        <!-- SALDO -->
                                        <Label Grid.Column="1" 
                                               Text="{Binding SaldoAtual, StringFormat='R$ {0:N0}'}"
                                               TextColor="#4CAF50"
                                               FontAttributes="Bold"
                                               FontSize="16"
                                               Margin="10,0"/>

                                        <!-- ÍCONES -->
                                        <HorizontalStackLayout Grid.Column="2" Spacing="20">
                                                <Image WidthRequest="18"
                                                   HeightRequest="18">

                                                    <Image.Source>
                                                        <FontImageSource
                                                            FontFamily="FASolid"
                                                            Glyph="{x:Static fa:Solid.Pen}"
                                                            Color="{StaticResource White}" />
                                                    </Image.Source>
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                                            Command="{Binding BindingContext.ContaBancariaVM.EditarContaCommand,
                                                                                              Source={x:Reference SaldoPageRef}}"
                                                                                              CommandParameter="{Binding .}" />
                                                    </Image.GestureRecognizers>
                                                </Image>

                                                <Image WidthRequest="18"
                                                   HeightRequest="18">
                                                    <Image.Source>
                                                        <FontImageSource
                                                            FontFamily="FASolid"
                                                            Glyph="{x:Static fa:Solid.TrashCan}"
                                                            Color="{StaticResource White}" />
                                                    </Image.Source>
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding BindingContext.ContaBancariaVM.RemoverContaCommand,
                                                            Source={x:Reference SaldoPageRef}}"
                                                            CommandParameter="{Binding .}" />
                                                    </Image.GestureRecognizers>
                                                </Image>
                                        </HorizontalStackLayout>

                                    </Grid>
                                </Border>
                                    <BoxView StyleClass="Divider" Margin="0" />
                                </VerticalStackLayout>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- BOTÃO NOVA CONTA -->
                    <Button Text="+ Nova Conta"
                            BackgroundColor="{StaticResource Gray700}"
                            TextColor="{StaticResource Gray300}"
                            CornerRadius="6"
                            Padding="0, 12"
                            Command="{Binding CriarContaCommand}"/>
                </VerticalStackLayout>
            </Border>

            <Label Text="Projeção"
                   FontSize="18"
                   Margin="0,0,0,5"
                   TextColor="#B0B0B0"
                   FontAttributes="Bold" />

            <Border
                BackgroundColor="#1E1F24"
                StrokeShape="RoundRectangle 9"
                StrokeThickness="0"
                BindingContext="{Binding ProjecaoVM}">

                <VerticalStackLayout Spacing="0">


                    <!-- CABEÇALHO -->
                    <Grid ColumnDefinitions="1.5*,3.25*,3.25*, 2*" Padding="16, 8, 0, 0">
                        <Label Text="Ano" TextColor="{StaticResource Gray400}" FontSize="16" />
                        <Label Grid.Column="1" Text="Investido(R$)" TextColor="{StaticResource Gray400}" FontSize="16"  />
                        <Label Grid.Column="2" Text="Saldo Total(R$)" TextColor="{StaticResource Gray400}" FontSize="16"  />
                    </Grid>

                    <BoxView StyleClass="Divider" Margin="0,10,0,0" />

                    <!-- LISTA -->
                    <CollectionView ItemsSource="{Binding Projecoes}"
                        SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ProjecaoDTO">
                                <VerticalStackLayout>

                                    <Border StrokeThickness="0"
                                        BackgroundColor="Transparent"
                                        Padding="16, 0, 16, 0"
                                        Margin="0,10">

                                        <Grid ColumnDefinitions="1.5*,3.25*,3.25*, 2*" 
                                          VerticalOptions="Center">

                                            <Label Grid.Column="0"
                                               Text="{Binding Ano}"
                                               TextColor="White"
                                               FontSize="16" />

                                            <Label Grid.Column="1" 
                                               Text="{Binding Investido, StringFormat='+{0:N0}'}"
                                               TextColor="#4CAF50"
                                               FontAttributes="Bold"
                                               FontSize="15"
                                               Margin="10,0"/>
                                            <Label Grid.Column="2" 
                                               Text="{Binding ValorTotal, StringFormat='{0:N0}'}"
                                               TextColor="#4CAF50"
                                               FontAttributes="Bold"
                                               FontSize="15"
                                               Margin="10,0"/>

                                            <!-- ÍCONES -->
                                            <HorizontalStackLayout Grid.Column="3" Spacing="20">
                                                <ImageButton MaximumWidthRequest="18" MaximumHeightRequest="18"
                                                             Clicked="EditarProjecao_Clicked" 
                                                             CommandParameter="{Binding .}">

                                                    <ImageButton.Source>
                                                        <FontImageSource
                                                            FontFamily="FASolid"
                                                            Glyph="{x:Static fa:Solid.Pen}"
                                                            Color="{StaticResource White}" />
                                                    </ImageButton.Source>
                                                </ImageButton>

                                                <Image WidthRequest="18"
                                                       HeightRequest="18"
                                                       IsVisible="{Binding PodeDeletar}">
                                                    <Image.Source>
                                                        <FontImageSource
                                                            FontFamily="FASolid"
                                                            Glyph="{x:Static fa:Solid.TrashCan}"
                                                            Color="{StaticResource White}" />
                                                    </Image.Source>
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding BindingContext.ProjecaoVM.RemoverProjecaoCommand,
                                                            Source={x:Reference SaldoPageRef}}"
                                                            CommandParameter="{Binding .}" />
                                                    </Image.GestureRecognizers>
                                                </Image>
                                            </HorizontalStackLayout>

                                        </Grid>
                                    </Border>
                                    <BoxView StyleClass="Divider" Margin="0" />
                                </VerticalStackLayout>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Button Text="+ Mais um ano"
                            BackgroundColor="{StaticResource Gray700}"
                            TextColor="{StaticResource Gray300}"
                            CornerRadius="6"
                            Padding="0, 12"
                            Clicked="AdicionarProjecao_Clicked"/>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>

    </ScrollView>
</ContentPage>